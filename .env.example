# Plantilla de variables de entorno para docker-compose.yml.
# Copiar como ".env" DENTRO de cada carpeta de ambiente en la VPS
# (svua-prod/.env y svua-dev/.env) y completar con valores reales.
# NUNCA commitear el .env real (ya esta en .gitignore).

# 🔥 Aisla nombres de contenedores/red/volumenes entre ambientes que
# corren en la MISMA VPS con el MISMO docker-compose.yml. Usar
# "svua_prod" en la carpeta de produccion y "svua_dev" en la de
# desarrollo (nunca el mismo valor en las dos).
PROJECT_NAME=svua_prod

# 🔥 Puertos publicados al host. En PROD deben ser 80/443 (dominio
# publico + certificado real). En DEV, como el dominio dev.svua.cl se
# sirve a traves del nginx de PROD (ver frontend/nginx.conf, red
# "edge_net"), estos puertos casi no se usan; se dejan en algo que no
# choque con prod solo por si se quiere entrar directo por IP:puerto
# (ej. 8081/8444).
HTTP_PORT=8081
HTTPS_PORT=8444

# 🔒 Postgres NO deberia quedar expuesto a internet en ningun ambiente.
# Se publica solo a localhost de la VPS (para poder conectarse con un
# cliente de BD via un tunel SSH si hace falta). Usar puertos distintos
# por ambiente si van a estar publicados al mismo tiempo (ej. 5432 en
# prod, 5433 en dev).
POSTGRES_HOST_PORT=127.0.0.1:5433

# nginx.conf en PROD (maneja TLS/certbot + hace de "puerta" para dev.svua.cl).
# nginx.dev.conf en DEV (HTTP simple, sin TLS: lo termina el nginx de PROD).
NGINX_CONF_FILE=nginx.conf

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=svua
POSTGRES_USER=svua
POSTGRES_PASSWORD=CAMBIAR_password_fuerte_y_distinto_por_ambiente

# 🔒 Generar uno DISTINTO por ambiente, por ejemplo con:
#   openssl rand -base64 48
JWT_SECRET=CAMBIAR_secreto_distinto_por_ambiente
JWT_EXPIRATION_TOKEN=1200000
JWT_REFRESH_EXPIRATION=604800000

# En dev usar: FRONTEND_URL=https://dev.svua.cl,
# BACKEND_URL=https://api-dev.svua.cl, API_URL=https://api-dev.svua.cl/api/v1/svua,
# WS_URL=wss://api-dev.svua.cl/ws
FRONTEND_URL=https://www.svua.cl
BACKEND_URL=https://api.svua.cl
API_URL=https://api.svua.cl/api/v1/svua
WS_URL=wss://api.svua.cl/ws

MAIL_HOST=mail.nexovectoria.cl
MAIL_PORT=465
MAIL_USERNAME=CAMBIAR
MAIL_PASSWORD=CAMBIAR
APP_USR-KEY=CAMBIAR

# 🔒 Dias que se conservan los dumps de Postgres en ./backups/postgres
# antes de borrarse automaticamente (ver scripts/backup-postgres.sh y
# docs/continuidad-negocio.md). 14 es un punto de partida razonable;
# ajustar segun cuanto espacio en disco tenga la VPS.
BACKUP_RETENTION_DIAS=14

# 🔥 En un ambiente de desarrollo con datos de prueba, este id va a
# apuntar a una empresa distinta (la BD de dev es propia y arranca
# vacia salvo lo que traigan las migraciones de Flyway).
EMPRESA_DEMO_ID=2

# 🔥 Job nocturno que borra ordenes/notificaciones/historial de la
# empresa demo y resetea su stock/estado de activos. Debe correr SOLO
# en producción (donde vive la empresa demo publica mostrada a
# prospectos). En dev dejar en false.
LIMPIEZA_DEMO_ENABLED=true
NOTIFICACION_MATENCIONES=true
DIAS_NOTIFICACION=7
HORA_NOTIFICACION=0 0 20 * * *

# Agregar aqui el/los dominio(s) de cada ambiente.
# En dev: CORS_ALLOWED_ORIGINS=https://dev.svua.cl,https://api-dev.svua.cl
CORS_ALLOWED_ORIGINS=https://www.svua.cl,https://svua.cl

tiempoInactividadMinutos=30
