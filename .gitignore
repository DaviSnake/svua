# See https://docs.github.com/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# Variables de entorno
.env
.env.*
# 🔥 excepcion: .env.example SI se commitea (es una plantilla sin secretos reales)
!.env.example
certbot/conf
certbot/www

# 🔥 Logs de errores de cargas masivas (ver ImportFileLogService /
# pantalla "Ver Logs"): quedan en disco, no se versionan.
log/
# Archivos temporales de parcheo (scripts de patch, verificaciones, locks)
_to_delete/
